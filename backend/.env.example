# Hanko API URL (internal service)
HANKO_API_URL=http://hanko:8000

# Cookie settings
COOKIE_SECRET=CHANGE_ME_PLEASE_MIN_32_BYTES_LONG_FOR_SECURITY
COOKIE_DOMAIN=.localhost

# Origins allowed to call this API with credentials, comma-separated. Required,
# with no default: each deployment lists its own.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3040,http://127.0.0.1:3040,http://localhost:5174,http://127.0.0.1:5174,https://portal.hotosm.test,https://login.hotosm.test,https://dronetm.hotosm.test,https://fair.hotosm.test,https://openaerialmap.hotosm.test,https://chatmap.hotosm.test,https://umap.hotosm.test,https://export-tool.hotosm.test

# OSM OAuth credentials
OSM_CLIENT_ID=your-osm-client-id-here
OSM_CLIENT_SECRET=your-osm-client-secret-here

# LearnWorlds Custom SSO (learn.hotosm.org / learn-dev.hotosm.org).
# Settings -> Developers -> API in the school panel. Each school has its own
# pair; the client id also ships in the school's public HTML, the secret does not.
LEARNWORLDS_SCHOOL_URL=https://learn-dev.hotosm.org
LEARNWORLDS_CLIENT_ID=your-learnworlds-client-id-here
LEARNWORLDS_CLIENT_SECRET=your-learnworlds-client-secret-here

# LinkedIn app, used only to find courses of people who joined the school with
# LinkedIn. Its redirect URL is {BACKEND_URL}/api/sso/learnworlds/linkedin/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
