server:
  public:
    address: ":8000"
    cors:
      allow_origins:
        # One pattern per environment instead of one per site. Echo (which
        # Hanko uses for CORS) turns * into the regex .*, and .* crosses dots,
        # so this also matches multi-label hosts like dev.portal.hotosm.org.
        #
        # Note this is NOT how allowed_redirect_urls below behaves: that one is
        # glob-based with "." as a separator, where * stops at a dot. Those stay
        # listed one by one on purpose — a redirect target is where the login
        # token is handed over, so it is worth naming each one.
        - "https://*.hotosm.org"
        - "https://*.hotosm.test"
        # The wildcard requires the leading dot, so the apex is listed too.
        - "https://hotosm.org"
        # Local development over plain http.
        - "http://localhost:5173"
        - "http://127.0.0.1:5173"
        - "http://localhost:3040"
        - "http://127.0.0.1:3040"
      allow_credentials: true
      unsafe_wildcard_origin_allowed: false

database:
  database: hanko
  user: hanko
  password: hanko
  host: hanko-db
  port: 5432

secrets:
  keys:
    # Encrypts the JWKs in the database — the private keys every session JWT is
    # signed with. Injected by the deploy from the HANKO_SECRET_KEY secret; the
    # placeholder is deliberately unusable so a config that skipped the
    # substitution fails loudly instead of running on a published key.
    #
    # Keep the old key below the new one while rotating. Hanko encrypts with
    # keys[0] and decrypts by trying each key in turn
    # (backend/crypto/aes_gcm/aes_gcm.go), and GetPublicKeys decrypts EVERY
    # stored JWK to serve /.well-known/jwks.json, returning an error on the
    # first one it cannot read. So dropping the old key before Hanko has
    # re-encrypted takes the whole JWKS endpoint down, and with it every app
    # that validates a token — not just the sessions signed with it.
    #
    # Remove the second entry only once the jwk rows have been re-encrypted.
    - "HANKO_SECRET_KEY_PLACEHOLDER"
    - "abcdefghijklmnopqrstuvwxyz123456"  # previous key, kept so old JWKs still decrypt

service:
  name: "HOTOSM Portal (Dev)"

account:
  allow_deletion: true

passkey:
  enabled: false
  acquire_on_login: never
  acquire_on_registration: never

mfa:
  security_keys:
    enabled: false

webauthn:
  enabled: false  # Passkeys disabled - using email/password + Google OAuth only
  relying_party:
    id: "hotosm.test"
    display_name: "HOTOSM Portal"
    origins:
      - "https://portal.hotosm.test"
      - "https://login.hotosm.test"
      - "https://dronetm.hotosm.test"
      - "https://fair.hotosm.test"
      - "https://openaerialmap.hotosm.test"
      - "https://chatmap.hotosm.test"
      - "https://umap.hotosm.test"
      - "https://export-tool.hotosm.test"

email:
  require_verification: true
  use_for_authentication: false

passcode:
  enabled: false
  ttl: 300  # 5 minutes

password:
  enabled: true
  min_length: 8
  recovery: true

# SMTP settings - values injected by deploy workflow via sed
email_delivery:
  enabled: true
  smtp:
    host: "SMTP_HOST_PLACEHOLDER"
    port: 587
    user: "SMTP_USER_PLACEHOLDER"
    password: "SMTP_PASSWORD_PLACEHOLDER"
  from_address: "SMTP_FROM_PLACEHOLDER"
  from_name: "HOTOSM"

session:
  lifespan: 1h
  issuer: "https://login.hotosm.test"
  audience:
    # Local development
    - "https://portal.hotosm.test"
    - "https://login.hotosm.test"
    - "https://dronetm.hotosm.test"
    - "https://fair.hotosm.test"
    - "https://openaerialmap.hotosm.test"
    - "https://chatmap.hotosm.test"
    - "https://umap.hotosm.test"
    - "https://export-tool.hotosm.test"
    # Test environments
    - "https://dronetm.testlogin.hotosm.org"
    - "https://fair.testlogin.hotosm.org"
    - "https://umap.testlogin.hotosm.org"
    - "https://export.testlogin.hotosm.org"
    # Production/dev
    - "https://dev.portal.hotosm.org"
    - "https://dev.login.hotosm.org"
    - "https://portal.hotosm.org"
    - "https://login.hotosm.org"
    - "https://drone.hotosm.org"
    - "https://fair.hotosm.org"
    - "https://fair-dev.hotosm.org"
    - "https://openaerialmap.hotosm.org"
    - "https://chatmap.hotosm.org"
    - "https://chatmap-dev.hotosm.org"
    - "https://umap.hotosm.org"
    - "https://umap-dev.hotosm.org"
    - "https://export-tool.hotosm.org"
  cookie:
    name: "hanko"
    domain: ".hotosm.test"  # .hotosm.test with dot enables cookie sharing across all *.hotosm.test subdomains
    http_only: true
    same_site: lax
    secure: true

third_party:
  redirect_url: "https://login.hotosm.test/thirdparty/callback"
  error_redirect_url: "https://login.hotosm.test/error"
  allowed_redirect_urls:
    # Local development
    - "https://portal.hotosm.test/**"
    - "https://login.hotosm.test/**"
    - "https://dronetm.hotosm.test/**"
    - "https://fair.hotosm.test/**"
    - "https://openaerialmap.hotosm.test/**"
    - "https://chatmap.hotosm.test/**"
    - "https://umap.hotosm.test/**"
    - "https://export-tool.hotosm.test/**"
    # Test environments
    - "https://dronetm.testlogin.hotosm.org/**"
    - "https://fair.testlogin.hotosm.org/**"
    - "https://umap.testlogin.hotosm.org/**"
    - "https://export.testlogin.hotosm.org/**"
    # Production/dev
    - "https://dev.portal.hotosm.org/**"
    - "https://dev.login.hotosm.org/**"
    - "https://portal.hotosm.org/**"
    - "https://login.hotosm.org/**"
    - "https://drone.hotosm.org/**"
    - "https://fair.hotosm.org/**"
    - "https://fair-dev.hotosm.org/**"
    - "https://openaerialmap.hotosm.org/**"
    - "https://chatmap.hotosm.org/**"
    - "https://chatmap-dev.hotosm.org/**"
    - "https://umap.hotosm.org/**"
    - "https://umap-dev.hotosm.org/**"
    - "https://export-tool.hotosm.org/**"
  cookie:
    domain: ".hotosm.test"  # .hotosm.test with dot enables cookie sharing across all *.hotosm.test subdomains
    http_only: true
    same_site: lax
    secure: true
  providers:
    google:
      enabled: true
      client_id: "GOOGLE_CLIENT_ID_PLACEHOLDER"
      secret: "GOOGLE_CLIENT_SECRET_PLACEHOLDER"
      allow_linking: true
