{
  "name": "@hotosm/permissions",
  "version": "0.1.0-dev.0",
  "description": "Share dialog web component for HOT tools, built on the hotosm-permissions REST contract",
  "type": "module",
  "module": "dist/hotosm-share-dialog.js",
  "types": "dist/hotosm-share-dialog.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hotosm-share-dialog.d.ts",
      "import": "./dist/hotosm-share-dialog.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "watch": "vite build --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "hotosm",
    "permissions",
    "sharing",
    "web-component",
    "lit",
    "webawesome"
  ],
  "author": "HOTOSM <tech@hotosm.org>",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/hotosm/login/tree/main/permissions-libs/web-component",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotosm/login.git",
    "directory": "permissions-libs/web-component"
  },
  "bugs": {
    "url": "https://github.com/hotosm/login/issues"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "3.11.0"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.11.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0"
  }
}
